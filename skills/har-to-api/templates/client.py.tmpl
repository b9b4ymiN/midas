#!/usr/bin/env python3
"""
Auto-generated Python client for {{TITLE}}.
Generated by the har-to-api skill from a captured OpenAPI spec.

Usage:
    export {{AUTH_ENV_NAME}}="<your captured token / cookie value>"
    python {{CLIENT_FILENAME}} <operation_id> [key=value ...]

Examples:
    python {{CLIENT_FILENAME}} op1
    python {{CLIENT_FILENAME}} op1 symbol=PTT.BK
    python {{CLIENT_FILENAME}} op1 symbol=PTT.BK --raw
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from typing import Any, Dict, Optional
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode
from urllib.request import Request, urlopen

# --------------------------------------------------------------------------- #
#  Configuration
# --------------------------------------------------------------------------- #
# The captured auth header(s) live in your environment, never in this file.
# Set {{AUTH_ENV_NAME}} before running. If the spec captured multiple auth
# headers, set one env var per header — see AUTH_HEADERS below.
AUTH_HEADERS = {{AUTH_HEADERS}}  # e.g. {"Authorization": "HAR2API_AUTH"}
BASE_URL = "{{BASE_URL}}"
TIMEOUT_S = 30

# --------------------------------------------------------------------------- #
#  Operations catalog (derived from the OpenAPI spec)
# --------------------------------------------------------------------------- #
OPERATIONS: Dict[str, Dict[str, Any]] = {{OPERATIONS}}

# --------------------------------------------------------------------------- #
#  HTTP plumbing (stdlib only — `requests` not required)
# --------------------------------------------------------------------------- #

def _resolve_auth_headers() -> Dict[str, str]:
    headers: Dict[str, str] = {}
    for header_name, env_var in AUTH_HEADERS.items():
        val = os.environ.get(env_var)
        if val:
            headers[header_name] = val if header_name.lower() != "authorization" else f"Bearer {val}"
    return headers


def _do_request(method: str, url: str, *,
                params: Optional[Dict[str, str]] = None,
                body: Optional[Any] = None) -> Any:
    if params:
        url = f"{url}?{urlencode(params)}"

    headers = {"Accept": "application/json"}
    headers.update(_resolve_auth_headers())

    data = None
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"

    req = Request(url, data=data, method=method, headers=headers)
    try:
        with urlopen(req, timeout=TIMEOUT_S) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
    except HTTPError as e:
        sys.stderr.write(f"HTTP {e.code} {e.reason}\n")
        sys.stderr.write(e.read().decode("utf-8", errors="replace")[:500] + "\n")
        sys.exit(1)
    except URLError as e:
        sys.stderr.write(f"Network error: {e.reason}\n")
        sys.exit(1)

    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return raw


def call(operation_id: str, **kwargs) -> Any:
    op = OPERATIONS.get(operation_id)
    if not op:
        raise KeyError(f"Unknown operation: {operation_id}. "
                       f"Available: {list(OPERATIONS)}")

    path = op["path"]
    query: Dict[str, str] = {}
    body: Optional[Any] = None

    for key, val in kwargs.items():
        token = "{" + key + "}"
        if token in path:
            path = path.replace(token, str(val))
        elif key in op.get("queryParams", []):
            query[key] = str(val)
        elif op["method"] in ("POST", "PUT", "PATCH"):
            body = {**(body or {}), key: val}
        else:
            # Unknown key → assume query param.
            query[key] = str(val)

    url = BASE_URL + path
    return _do_request(op["method"], url, params=query or None, body=body)


# --------------------------------------------------------------------------- #
#  CLI
# --------------------------------------------------------------------------- #

def _list_ops() -> None:
    print(f"{'ID':<6} {'METHOD':<7} {'PATH'}")
    print("-" * 60)
    for op_id, op in OPERATIONS.items():
        print(f"{op_id:<6} {op['method']:<7} {op['path']}")


def main() -> int:
    p = argparse.ArgumentParser(description="Generated API client")
    p.add_argument("operation", nargs="?", help="operationId (e.g. op1) or 'list'")
    p.add_argument("kv", nargs="*", help="key=value args (path/query/body)")
    p.add_argument("--raw", action="store_true",
                   help="print raw JSON without pretty-printing")
    args = p.parse_args()

    if not args.operation or args.operation == "list":
        _list_ops()
        return 0

    kwargs: Dict[str, str] = {}
    for token in args.kv:
        if "=" not in token:
            print(f"bad arg '{token}', expected key=value", file=sys.stderr)
            return 2
        k, v = token.split("=", 1)
        kwargs[k] = v

    result = call(args.operation, **kwargs)
    if args.raw:
        print(json.dumps(result) if not isinstance(result, str) else result)
    else:
        print(json.dumps(result, indent=2, ensure_ascii=False)
              if not isinstance(result, str) else result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
